---
import '../styles/global.css';
import unbounded from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import geist from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import atlasLg from '../assets/hero/atlas-lg.avif?url';
import atlasSm from '../assets/hero/atlas-sm.avif?url';
import { content, LINKS, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const path = lang === 'en' ? '/' : '/es/';
const canonical = new URL(path, Astro.site).href;
// One card per language; the version bumps when the picture changes, so chats refetch it.
const ogImage = new URL(`/og-${lang}.jpg?v=3`, Astro.site).href;
const onVercel = import.meta.env.PROD && Boolean(process.env.VERCEL);

const fontFaces = `
@font-face{font-family:'Archivo Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${unbounded}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${geist}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Fabio Ramos',
  url: LINKS.site,
  image: new URL('/og-en.jpg', Astro.site).href,
  jobTitle: t.hero.role,
  address: { '@type': 'PostalAddress', addressLocality: 'San Miguel de Tucumán', addressCountry: 'AR' },
  worksFor: { '@type': 'Organization', name: 'CAW Tech', url: 'https://www.caw.com.ar' },
  sameAs: [LINKS.linkedin, LINKS.github, LINKS.youtube],
  knowsAbout: ['TypeScript', 'React', 'Next.js', 'Node.js', 'Supabase', 'PostgreSQL', 'SQL'],
};

// Decides the intro mode before first paint, so nothing flashes. The scroll lock is
// set here too (one layout instead of two) and released if the page script never runs.
const boot = `(function(){var d=document.documentElement,s=false;d.classList.add('js');if(location.hash)d.classList.add('all-in');try{s=sessionStorage.getItem('fr-intro')==='1'}catch(e){}if(matchMedia('(prefers-reduced-motion: reduce)').matches){d.classList.add('intro-done');return}if(s){d.classList.add('intro-short');return}d.classList.add('intro','intro-lock');setTimeout(function(){if(!d.classList.contains('intro-done')&&!d.classList.contains('intro--dark'))d.classList.remove('intro-lock')},9000)})();`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content="Fabio Ramos" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site).href} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={unbounded} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <!-- The hero board is one image per screen size: fetched straight away, ready before the intro ends. -->
    <link rel="preload" as="image" type="image/avif" href={atlasSm} media="(max-width: 699.98px)" />
    <link rel="preload" as="image" type="image/avif" href={atlasLg} media="(min-width: 700px)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:site_name" content="Fabio Ramos" />
    <meta property="og:description" content={t.meta.card} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.cardAlt} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_AR'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_AR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.card} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.cardAlt} />

    <style set:html={fontFaces}></style>
    <script is:inline set:html={boot}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    {onVercel && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <slot />
  </body>
</html>
