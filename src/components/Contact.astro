---
import Ambient from './Ambient.astro';
import { Image } from 'astro:assets';
import { media } from '../data/media';
import { LINKS, type Content } from '../i18n/content';
import Ext from './Ext.astro';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const c = t.contact;

// Eight keys, two even rows of four. Top: the ways to reach me.
// Bottom: everything else (copy the address, the channel, the two CVs).
const top = [
  { id: 'whatsapp', label: c.whatsapp, kind: c.kinds.whatsapp, href: LINKS.whatsapp, ext: true, shot: null },
  { id: 'linkedin', label: 'LinkedIn', kind: c.kinds.linkedin, href: LINKS.linkedin, ext: true, shot: 'social-linkedin.png' },
  { id: 'github', label: 'GitHub', kind: c.kinds.github, href: LINKS.github, ext: true, shot: 'social-github.png' },
];
const bottom = [
  { id: 'youtube', label: 'YouTube', kind: c.kinds.youtube, href: LINKS.youtube, ext: true, shot: 'social-youtube.png' },
  { id: 'cv-en', label: c.cvEn, kind: c.kinds.cv, href: LINKS.cvEn, ext: false, shot: 'cv-en.png' },
  { id: 'cv-es', label: c.cvEs, kind: c.kinds.cv, href: LINKS.cvEs, ext: false, shot: 'cv-es.png' },
];
const keys = [...top, ...bottom];
---

<!-- The only place with outbound profile links: the visit ends here, it does not start here. -->
<footer class="contact cut-r" id="contact" data-live aria-labelledby="contact-title">
  <Ambient kind="embers" />
  <div class="wrap">
    <div class="contact__head" data-rise>
      <p class="eyebrow" data-n="09">{c.label}</p>
      <h2 class="contact__title display" id="contact-title">{c.title}</h2>
      <p class="contact__text">{c.text}</p>
    </div>

    <!-- The board from the top of the page, now with something printed on every key. -->
    <ul class="keys" data-keys>
      <li class="keys__wide keys__mail">
        <a class="key key--main" href={`mailto:${LINKS.email}`}>
          <span class="key__kind">{c.emailKind}</span>
          <span class="key__label display">{c.email}</span>
          <span class="key__sub">{LINKS.email}</span>
          <span class="key__n" aria-hidden="true">01</span>
        </a>
      </li>
      {
        top.map((key, i) => (
          <li>
            <a class="key" href={key.href} target="_blank" rel="noopener" data-peek-id={key.id}>
              <span class="key__kind">{key.kind}</span>
              <span class="key__label display">{key.label}</span>
              <span class="key__n" aria-hidden="true">0{i + 2}</span>
              <Ext />
            </a>
          </li>
        ))
      }
      <li class="keys__wide keys__copy">
        <button class="key" type="button" data-copy={LINKS.email} data-copied={c.copied}>
          <span class="key__kind">Email</span>
          <span class="key__label display" data-copy-label>{c.copy}</span>
          <span class="key__n" aria-hidden="true">05</span>
        </button>
      </li>
      {
        bottom.map((key, i) => (
          <li>
            <a class="key" href={key.href} target="_blank" rel="noopener" data-peek-id={key.id}>
              <span class="key__kind">{key.kind}</span>
              <span class="key__label display">{key.label}</span>
              <span class="key__n" aria-hidden="true">0{i + 6}</span>
              {key.ext ? (
                <Ext />
              ) : (
                <svg class="ext key__dl" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M6 .5v7.5M2.5 4.8 6 8.3l3.5-3.5M1 11h10" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Hover previews: a look at the page (or the chat) before the click. -->
    <div class="peeks" data-peeks aria-hidden="true">
      {
        keys.map((key) =>
          key.shot ? (
            <span class:list={['peek', `peek--${key.id.startsWith('cv') ? 'doc' : key.id}`]} data-peek-for={key.id}>
              <Image src={media(key.shot)} alt="" widths={[420, 720]} sizes="22rem" format="avif" quality={60} loading="lazy" decoding="async" />
              <b>{key.label}</b>
            </span>
          ) : (
            <span class="peek peek--chat" data-peek-for={key.id}>
              <span class="peek__who">
                <Image src={media('social-avatar.png')} alt="" width={96} height={96} format="avif" quality={60} loading="lazy" decoding="async" />
                <span>
                  <b>Fabio Ramos</b>
                  <i>{c.waStatus}</i>
                </span>
              </span>
              <span class="peek__chat">
                {c.waPreview.map((line) => <span>{line}</span>)}
                <em><i /><i /><i /></em>
              </span>
            </span>
          ),
        )
      }
    </div>
  </div>

  <div class="foot">
    <p class="wrap contact__legal">
      <span>© {new Date().getFullYear()} Fabio Ramos. {c.legal}.</span>
      <a href="#top">{c.top} ↑</a>
    </p>
  </div>
</footer>

<style is:global>
  .contact {
    position: relative;
    padding-block: calc(var(--section-y) + var(--cut)) 0;
    background:
      radial-gradient(70rem 34rem at 50% 108%, rgb(16 185 129 / 0.42), rgb(6 95 70 / 0.22) 45%, transparent 72%), #000;
    overflow: hidden;
  }

  .contact__head {
    display: grid;
    gap: 1rem;
  }

  .contact__title {
    font-size: var(--step-4);
    max-width: 14ch;
    text-transform: uppercase;
  }

  .contact__text {
    max-width: 38rem;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink-dim);
  }

  .keys {
    --wall: 7px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(var(--wall) + 0.6rem);
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-right: var(--wall);
  }

  .keys__wide {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .keys {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .keys__wide {
      grid-column: span 1;
    }
  }

  /* Phones: both email keys first, full width, then three even pairs. */
  @media (max-width: 899.98px) {
    .keys__mail {
      order: -2;
    }

    .keys__copy {
      order: -1;
    }
  }

  .keys li {
    display: grid;
  }

  .key {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 1.5rem;
    min-height: clamp(8rem, 13vw, 11.5rem);
    padding: 0.9rem 1rem 1rem;
    background: var(--graphite);
    border: 1px solid var(--line);
    box-shadow: var(--wall) var(--wall) 0 var(--emerald-deep);
    color: var(--ink);
    text-align: left;
    transition:
      transform 0.18s var(--ease-out),
      box-shadow 0.18s var(--ease-out),
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }

  .key:hover,
  .key:focus-visible {
    transform: translate(calc(var(--wall) - 2px), calc(var(--wall) - 2px));
    box-shadow: 2px 2px 0 var(--emerald-deep);
    background: var(--emerald);
    border-color: var(--emerald);
    color: #00130c;
  }

  .key:active {
    transform: translate(var(--wall), var(--wall));
    box-shadow: 0 0 0 var(--emerald-deep);
  }

  .key--main {
    background: var(--emerald);
    border-color: var(--emerald);
    color: #00130c;
    box-shadow: var(--wall) var(--wall) 0 var(--accent);
  }

  .key--main:hover,
  .key--main:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 2px 2px 0 #7a1027;
    color: #1a0006;
  }

  .key__kind {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .key--main .key__kind,
  .key--main .key__n {
    opacity: 1;
  }

  .key__label {
    font-size: clamp(1.15rem, 0.9rem + 1vw, 1.9rem);
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .key__sub {
    margin-top: -1.1rem;
    font-size: var(--step--1);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .key__n {
    position: absolute;
    right: 0.9rem;
    top: 0.8rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    opacity: 0.55;
  }

  .key .ext {
    position: absolute;
    right: 1rem;
    bottom: 1.1rem;
    width: 0.9rem;
    height: 0.9rem;
  }

  /* Previews follow the cursor over the keys (page.ts moves the holder). */
  .peeks {
    display: none;
  }

  @media (hover: hover) and (min-width: 900px) {
    .peeks {
      display: block;
      position: fixed;
      left: 0;
      top: 0;
      z-index: 30;
      width: 22rem;
      pointer-events: none;
      will-change: transform;
    }
  }

  .peek {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    display: grid;
    background: var(--coal);
    border: 1px solid var(--accent);
    box-shadow:
      6px 6px 0 #7a1027,
      0 30px 60px -20px rgb(0 0 0 / 0.8);
    opacity: 0;
    scale: 0.94;
    transform-origin: 0 100%;
    transition:
      opacity 0.2s var(--ease-out),
      scale 0.35s var(--ease-out);
  }

  .peek.is-on {
    opacity: 1;
    scale: 1;
  }

  .peek img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }

  .peek--youtube img {
    aspect-ratio: 3 / 1;
    object-position: left center;
  }

  .peek--doc img {
    aspect-ratio: 4 / 3.4;
    object-position: top center;
    background: #fff;
  }

  .peek > b {
    padding: 0.55rem 0.8rem;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .peek__who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    background: #0b3d2e;
  }

  .peek__who img {
    width: 2.6rem;
    height: 2.6rem;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .peek__who span {
    display: grid;
    line-height: 1.25;
  }

  .peek__who i {
    font-size: var(--step--1);
    font-style: normal;
    color: var(--emerald-ice);
  }

  .peek__chat {
    display: grid;
    justify-items: end;
    gap: 0.4rem;
    padding: 1rem 0.9rem 1.1rem;
    font-size: var(--step--1);
  }

  .peek__chat > span {
    max-width: 85%;
    padding: 0.5rem 0.7rem;
    background: var(--emerald);
    color: #00130c;
    font-weight: 500;
  }

  .peek__chat em {
    justify-self: start;
    display: flex;
    gap: 0.25rem;
    margin-top: 0.35rem;
    padding: 0.65rem 0.7rem;
    background: var(--graphite-2);
  }

  .peek__chat em i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ink-dim);
    animation: peek-typing 1.1s infinite;
  }

  .peek__chat em i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .peek__chat em i:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes peek-typing {
    0%,
    60%,
    100% {
      opacity: 0.3;
      transform: none;
    }
    30% {
      opacity: 1;
      transform: translateY(-0.2rem);
    }
  }

  /* The footer: a dark bar across the whole page, ruled off by the same glint
     that runs along the section cuts, here on a straight line. */
  .foot {
    position: relative;
    margin-top: clamp(3.5rem, 8vw, 6.5rem);
    background: #030504;
    overflow: hidden;
  }

  .foot::before,
  .foot::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 1px;
    width: 100%;
    background: rgb(16 185 129 / 0.45);
  }

  .foot::after {
    width: 16%;
    height: 2px;
    background: linear-gradient(90deg, transparent, #a7f3d0 40%, #a7f3d0 60%, transparent);
    box-shadow: 0 0 10px var(--emerald);
    animation: seam-flat 3.1s cubic-bezier(0.7, 0, 0.3, 1) infinite alternate;
    will-change: transform;
  }

  .contact__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.1rem;
    font-size: var(--step--1);
    color: var(--ink-dim);
  }

  .contact__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact__legal a:hover {
    color: var(--accent);
  }
</style>
