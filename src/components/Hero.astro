---
import atlas from '../assets/hero/atlas.json';
import atlasLg from '../assets/hero/atlas-lg.avif?url';
import atlasSm from '../assets/hero/atlas-sm.avif?url';
import { heroShots } from '../data/media';
import { LINKS, type Content } from '../i18n/content';

interface Props {
  t: Content;
}

const { t } = Astro.props;

// A board of N lanes. Each lane carries one spare tile so it can slide
// sideways forever: whatever leaves one end is moved to the other.
const N = 10;
const cells = Array.from({ length: N * (N + 1) }, (_, i) => {
  const r = Math.floor(i / (N + 1));
  const c = i % (N + 1);
  const dx = c - N / 2;
  const dy = r + 0.5 - N / 2;
  // `side` is how far left or right of the screen's centre line the cell sits.
  return { i, r, c, dist: Math.hypot(dx, dy), depth: dx + dy, side: Math.abs(dx - dy) };
});

// Which picture goes on which key. The lanes slide against each other and the
// whole board travels across them, so "far apart at build time" is not enough:
// two copies of a picture could drift side by side. The rule that survives any
// movement is structural. The list is dealt into five hands (every fifth
// picture), and a lane only ever shows one hand, without repeats. With ten
// lanes, two lanes share a hand only when they are five apart, and that stays
// true when the board wraps round: the same picture is never closer than five
// lanes away, wherever the lanes have slid to.
// Fewer pictures means fewer hands (and copies a little closer), never a broken build.
const total = heroShots.length;
const HANDS = Math.min(5, Math.floor(total / (N + 1)));
if (HANDS < 2) throw new Error(`The hero needs at least ${2 * (N + 1)} pictures to keep duplicates apart; it has ${total}.`);
const hands = Array.from({ length: HANDS }, (_, hand) => heroShots.map((_, i) => i).filter((i) => i % HANDS === hand));
// Columns from the centre outwards: the list is in order of importance, and the first of each hand should land in the middle.
const inward = Array.from({ length: N + 1 }, (_, c) => c).sort((x, y) => Math.abs(x - N / 2) - Math.abs(y - N / 2) || x - y);
const shotAt = new Map<number, number>();
for (let r = 0; r < N; r++) {
  const hand = hands[r % HANDS];
  // Lanes that share a hand start at different places in it, the central lane first.
  const twins = Array.from({ length: N }, (_, lane) => lane).filter((lane) => lane % HANDS === r % HANDS);
  twins.sort((x, y) => Math.abs(x + 0.5 - N / 2) - Math.abs(y + 0.5 - N / 2));
  const turn = twins.indexOf(r) * 5;
  inward.forEach((c, k) => shotAt.set(r * (N + 1) + c, hand[(k + turn) % hand.length]));
}

// Drop order: the far end of the board first, so near keys land over far ones.
const jitter = (i: number) => ((i * 7919) % 17) / 17;
const dropOrder = [...cells].sort((a, b) => a.depth + jitter(a.i) * 2.4 - (b.depth + jitter(b.i) * 2.4));
const orderOf = new Map(dropOrder.map((cell, n) => [cell.i, n]));
// The intro waits for this key: the last one to land among those every screen shows.
const lastCell = [...dropOrder].reverse().find((cell) => cell.side <= 3)!;

// Every picture lives in one atlas per screen size (scripts/hero-atlas.mjs), so
// the board is one download, not fifty. A tile only needs its cell in the sheet.
if (atlas.files.join() !== heroShots.map((shot) => shot.file).join()) {
  throw new Error('The hero atlas is out of date: run `npm run atlas` and commit the result.');
}
const shots = heroShots.map((shot, i) => ({ ...shot, col: i % atlas.cols, row: Math.floor(i / atlas.cols) }));
const sheet = `.tiles__grid{--cols:${atlas.cols};--rows:${atlas.rows};--atlas:url(${atlasSm})}@media (min-width:700px){.tiles__grid{--atlas:url(${atlasLg})}}`;

const lanes = Array.from({ length: N }, (_, r) =>
  cells
    .filter((cell) => cell.r === r)
    .map((cell) => ({
      order: orderOf.get(cell.i)!,
      dist: Math.round(cell.dist * 10) / 10,
      last: cell.i === lastCell.i,
      shot: shots[shotAt.get(cell.i)!],
    })),
);

// Narrow screens only ever see the middle of the board. Keys outside that band
// are switched off by position (not by identity), so the lanes can keep
// recycling keys through it.
const band = (reach: number) =>
  Array.from({ length: N }, (_, r) => {
    const lo = Math.max(1, Math.ceil(r + 0.5 - reach) + 1);
    const hi = Math.min(N + 1, Math.floor(r + 0.5 + reach) + 1);
    return `.lane:nth-child(${r + 1})>.tile:not(:nth-child(n+${lo}):nth-child(-n+${hi}))`;
  }).join(',');
const off = '{visibility:hidden;content-visibility:hidden;animation:none!important}';
const bands = `@media (max-width:699.98px){${band(3.5)}${off}}@media (min-width:700px) and (max-width:1099.98px){${band(5)}${off}}`;

const cta = [
  { href: '#contact', label: t.hero.cta[0], solid: true },
  { href: '#about', label: t.hero.cta[1], solid: false },
  { href: '#experience', label: t.hero.cta[2], solid: false },
];
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="tiles" aria-hidden="true">
    <div class="tiles__grid">
      {
        lanes.map((lane, r) => (
          <div class="lane" data-lane={r % 2 ? 1 : -1}>
            {lane.map((tile) => (
              <div class="tile" style={`--o:${tile.order};--d:${tile.dist}`} data-last={tile.last ? '' : undefined}>
                <span class="tile__cap">
                  <span class="tile__up">
                    <span class="tile__img" style={`--ax:${tile.shot.col};--ay:${tile.shot.row}`} />
                    <span class="tile__label">{tile.shot.label}</span>
                  </span>
                </span>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <style set:html={bands + sheet}></style>
  <div class="hero__shade" aria-hidden="true"></div>

  <canvas class="hero__fx" aria-hidden="true"></canvas>

  <div class="hero__copy">
    <h1 class="hero__name" id="hero-name"><span>Fabio</span> <span>Ramos</span></h1>
    <div class="hero__meta">
      <p class="hero__role">{t.hero.role}</p>
      <p class="hero__line">{t.hero.line}</p>
      <p class="hero__cta">
        {
          cta.map((link) => (
            <a class:list={['btn', { 'btn--solid': link.solid }]} href={link.href}>
              {link.label}
            </a>
          ))
        }
      </p>
    </div>
  </div>

  <!-- Quick access: peeks out after the intro, then tucks back to a tab on the edge. -->
  <aside class="hero__cv" data-cv>
    <button class="hero__cv-tab" type="button" aria-expanded="false" aria-controls="hero-cv-links" aria-label={`CV: ${t.hero.cv}`}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3v11M7 10l5 5 5-5M4 20h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path></svg>
      <span>CV</span>
    </button>
    <div class="hero__cv-links" id="hero-cv-links">
      <span>{t.hero.cv}</span>
      <a href={LINKS.cvEn} download hreflang="en">EN</a>
      <a href={LINKS.cvEs} download hreflang="es">ES</a>
    </div>
  </aside>

  <a class="hero__cue" href="#volley-manager">
    <span>{t.hero.cue}</span>
    <svg viewBox="0 0 12 28" width="12" height="28" aria-hidden="true"><path d="M6 0v26M1 21l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
  </a>

  <button class="hero__skip" type="button" data-intro-skip>{t.hero.skip}</button>
  <button class="hero__replay" type="button" data-intro-replay aria-label={t.hero.replay} title={t.hero.replay}>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12a8 8 0 1 1 2.6 5.9M4 20v-5h5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"></path></svg>
  </button>
</section>

<style is:global>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 36rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #000;
    isolation: isolate;
  }

  /* The board: one plane tilted in 3D and turned 45 degrees, like looking
     across a keyboard. Everything on it shares the same perspective. */
  .tiles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    contain: strict;
    perspective: 1700px;
    perspective-origin: 50% 42%;
  }

  .tiles__grid {
    --n: 10;
    /* Oversized on purpose: the far end of the board is foreshortened, and it has to
       reach past both top corners of the screen with room to spare for the drift. */
    --s: calc(1.46 * (100vw + 1.7 * max(100svh, 36rem)) / (1.41421 * var(--n)));
    --wall: calc(var(--s) * 0.085);
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--s) * var(--n));
    height: calc(var(--s) * var(--n));
    margin: calc(var(--s) * var(--n) / -2) 0 0 calc(var(--s) * var(--n) / -2);
    transform: translateY(-3%) rotateX(54deg) rotateZ(45deg);
    transform-style: preserve-3d;
  }

  .lane {
    display: flex;
    width: calc(var(--s) * (var(--n) + 1));
    height: var(--s);
    transform: translate3d(calc(var(--s) * -0.5), 0, 0);
    transform-style: preserve-3d;
  }

  .tile {
    position: relative;
    flex: none;
    width: var(--s);
    height: var(--s);
    padding: calc(var(--s) * 0.035) calc(var(--s) * 0.035 + var(--wall)) calc(var(--s) * 0.035 + var(--wall)) calc(var(--s) * 0.035);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* The keycap: a flat top with two visible walls, drawn as a hard shadow
     towards the viewer. Pressing it slides the top down into its walls. */
  .tile__cap {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    background: #0b100e;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.09),
      calc(var(--wall) * 0.5) calc(var(--wall) * 0.5) 0 #0d2a20,
      var(--wall) var(--wall) 0 #071711;
    transition:
      transform 0.9s var(--ease-out),
      box-shadow 0.9s var(--ease-out);
  }

  .tile__cap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--emerald-ice);
    opacity: 0;
    pointer-events: none;
  }

  /* The picture is turned back upright inside the diamond. */
  .tile__up {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .tile__img {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 141.5%;
    height: 141.5%;
    /* Its cell of the atlas: the sheet is scaled to cols x rows tiles, then slid into place. */
    background-image: var(--atlas);
    background-size: calc(var(--cols) * 100%) calc(var(--rows) * 100%);
    background-position: calc(var(--ax) / (var(--cols) - 1) * 100%) calc(var(--ay) / (var(--rows) - 1) * 100%);
    transform: translate(-50%, -50%) rotate(-45deg);
    opacity: 0.36;
    transition: opacity 1.2s var(--ease-out);
  }

  /* Right after the intro the board is already moving; the pictures then come
     back on from the centre outwards. */
  html.intro-settle .tile__img {
    transition-delay: calc(var(--d) * 70ms + 0.3s);
  }

  .tile__label {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(-45deg) translateY(calc(var(--s) * 0.3));
    padding: 0.3em 0.6em;
    background: #000;
    color: var(--emerald-ice);
    font-family: var(--font-display);
    font-size: clamp(0.6rem, calc(var(--s) * 0.06), 1rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    html.intro-done .tile:hover .tile__cap {
      transform: translate3d(calc(var(--wall) * 0.7), calc(var(--wall) * 0.7), 0);
      box-shadow:
        inset 0 0 0 2px var(--emerald),
        calc(var(--wall) * 0.15) calc(var(--wall) * 0.15) 0 #0d2a20,
        calc(var(--wall) * 0.3) calc(var(--wall) * 0.3) 0 #071711;
      transition-duration: 0.12s;
    }

    html.intro-done .tile:hover .tile__img {
      opacity: 1;
      transition-duration: 0.15s;
      transition-delay: 0s;
    }

    html.intro-done .tile:hover .tile__label {
      opacity: 1;
      transition-duration: 0.15s;
    }
  }

  /* Click: a pulse that runs through every other key, starting at the one hit. */
  .tile.is-ping .tile__cap {
    animation: tile-ping 0.75s var(--ease-out) both;
    animation-delay: var(--pd, 0ms);
  }

  .tile.is-ping .tile__cap::after {
    animation: tile-flash 0.75s var(--ease-out) both;
    animation-delay: var(--pd, 0ms);
  }

  @keyframes tile-ping {
    0%,
    100% {
      transform: none;
    }
    22% {
      transform: translate3d(calc(var(--wall) * 0.85), calc(var(--wall) * 0.85), 0);
    }
    55% {
      transform: translate3d(calc(var(--wall) * -0.25), calc(var(--wall) * -0.25), 0);
    }
  }

  @keyframes tile-flash {
    0%,
    100% {
      opacity: 0;
    }
    22% {
      opacity: 0.4;
    }
  }

  /* Keeps the type readable over the board without hiding it. */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 75% 55% at 50% 50%, rgb(0 0 0 / 0.8), rgb(0 0 0 / 0.35) 70%, transparent),
      linear-gradient(rgb(0 0 0 / 0.75), transparent 22%, transparent 70%, #000);
    transition: opacity 0.8s var(--ease-out);
  }

  /* The shade is there from the first frame: the keys fall into a dim room,
     they are never brighter during the intro than they are afterwards. */

  /* Intro, act 1: every key falls onto the board, out of focus until it lands. */
  html.intro .tile {
    /* Both on the key itself: one compositor layer per key, not two. */
    animation:
      tile-drop 0.5s cubic-bezier(0.3, 1.25, 0.5, 1) both,
      tile-focus 0.6s var(--ease-out) both;
    /* A short stagger: the whole board is down in about a second, so the name
       (the first thing worth reading) is not kept waiting. */
    animation-delay: calc(var(--o) * 6ms + 40ms);
  }

  /* Phones skip the focus pull: blurring every falling key is the most
     expensive part of the intro, and the least visible on a small screen. */
  @media (max-width: 699.98px) {
    html.intro .tile {
      animation: tile-drop 0.5s cubic-bezier(0.3, 1.25, 0.5, 1) both;
      animation-delay: calc(var(--o) * 6ms + 40ms);
    }
  }

  /* The keys fall blank: dark caps, no pictures. Those come on after the name. */
  html.intro .tile__img {
    opacity: 0;
    transition: none;
  }

  /* While they fall the caps are darker still, and their walls barely lit. */
  html.intro .tile__cap {
    background: #060908;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.05),
      calc(var(--wall) * 0.5) calc(var(--wall) * 0.5) 0 #081a14,
      var(--wall) var(--wall) 0 #040d0a;
  }

  /* Act 2: the name starts to form and, in the same instant, sends one pulse
     through the whole board from where it stands. */
  html.intro.intro--reveal .tile__cap {
    animation: tile-ping 0.8s var(--ease-out) both;
    animation-delay: calc(var(--d) * 55ms);
  }

  html.intro.intro--reveal .tile__cap::after {
    animation: tile-flash 0.8s var(--ease-out) both;
    animation-delay: calc(var(--d) * 55ms);
  }

  @keyframes tile-drop {
    from {
      opacity: 0;
      transform: translate3d(0, 0, calc(var(--s) * 3.2)) rotate(12deg);
    }
    40% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes tile-focus {
    from {
      filter: blur(18px);
    }
    45% {
      filter: blur(12px);
    }
    to {
      filter: blur(0);
    }
  }

  /* Act 3: the name condenses out of light (canvas), then the DOM takes over. */
  .hero__fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
  }

  html.intro--reveal .hero__fx {
    opacity: 1;
  }

  html.intro-done .hero__fx {
    display: none;
  }

  .hero__copy {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-inline: var(--gutter);
    text-align: center;
    pointer-events: none;
  }

  .hero__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 11.4vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: #fff;
  }

  .hero__name {
    white-space: nowrap;
  }

  @media (min-width: 700px) {
    .hero__name {
      font-size: clamp(4rem, 6.4vw, 8rem);
    }
  }

  .hero__meta {
    margin-top: clamp(1.25rem, 2.6vw, 2rem);
    display: grid;
    gap: 0.7rem;
    justify-items: center;
    transition:
      opacity 0.9s var(--ease-out) 0.15s,
      transform 0.9s var(--ease-out) 0.15s;
  }

  .hero__role {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--emerald-ice);
  }

  .hero__line {
    max-width: 48rem;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--ink);
    text-wrap: balance;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.9rem;
    pointer-events: auto;
  }

  .hero__cta .btn:not(.btn--solid) {
    background: rgb(0 0 0 / 0.7);
  }

  html.intro .hero__copy {
    opacity: 0;
    /* If the script never runs, the name still shows up. */
    animation: intro-failsafe 1ms 9s forwards;
  }

  html.intro.intro--reveal .hero__copy {
    opacity: 1;
    animation: none;
  }

  html.intro .hero__name {
    opacity: 0;
  }

  /* The real type takes over from the canvas at once: no soft, upscaled frame in between. */
  html.intro.name-on .hero__name {
    opacity: 1;
    transition: opacity 0.12s linear;
  }

  html.intro .hero__meta,
  html.intro-short .hero__meta {
    opacity: 0;
    transform: translateY(0.75rem);
  }

  html.intro .hero__cta,
  html.intro-short .hero__cta {
    pointer-events: none;
  }

  /* No-WebGL and repeat-visit reveal: the same idea in plain CSS. */
  html.intro--css .hero__name,
  html.intro-short .hero__name {
    animation: name-condense 1.3s var(--ease-out) both;
  }

  html.intro-short .hero__name {
    animation-duration: 0.95s;
  }

  @keyframes name-condense {
    from {
      opacity: 0;
      filter: blur(26px);
      color: var(--emerald);
      transform: scale(1.06);
    }
    55% {
      color: var(--emerald-ice);
    }
    to {
      opacity: 1;
      filter: blur(0);
      color: #fff;
      transform: none;
    }
  }

  @keyframes intro-failsafe {
    to {
      opacity: 1;
    }
  }

  /* Résumé tab on the right edge ------------------------------------------ */
  .hero__cv {
    --tab: 3.4rem;
    position: absolute;
    right: 0;
    top: calc(var(--bar) + 0.9rem);
    z-index: 4;
    display: flex;
    align-items: stretch;
    background: var(--emerald);
    color: #00130c;
    box-shadow: -6px 6px 0 var(--emerald-deep);
    transform: translateX(calc(100% - var(--tab)));
    transition: transform 0.65s cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  .hero__cv:hover,
  .hero__cv:focus-within,
  .hero__cv.is-open {
    transform: none;
  }

  html.intro .hero__cv,
  html.intro-short .hero__cv {
    transform: translateX(110%);
  }

  .hero__cv-tab {
    flex: none;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.2rem;
    width: var(--tab);
    min-height: 4rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 800;
  }

  /* A small wave now and then, so the tab is noticed without nagging. */
  .hero__cv-tab svg {
    animation: cv-nudge 5s var(--ease-in-out) infinite;
  }

  @keyframes cv-nudge {
    0%,
    78%,
    100% {
      transform: none;
    }
    84% {
      transform: translateY(4px) rotate(-8deg);
    }
    90% {
      transform: translateY(-2px) rotate(6deg);
    }
    95% {
      transform: translateY(2px);
    }
  }

  .hero__cv-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem 0.6rem 0.4rem;
    font-size: var(--step--1);
    font-weight: 700;
    white-space: nowrap;
  }

  .hero__cv-links a {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    background: #00130c;
    color: var(--emerald-ice);
    font-family: var(--font-display);
    font-weight: 800;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .hero__cv-links a:hover {
    background: var(--accent);
    color: #1a0006;
  }

  /* Corner controls ------------------------------------------------- */
  .hero__cue,
  .hero__skip,
  .hero__replay {
    position: absolute;
    z-index: 4;
    bottom: clamp(1rem, 2.4vw, 1.75rem);
    font-size: var(--step--1);
    color: var(--ink-dim);
    transition:
      opacity 0.6s var(--ease-out),
      color 0.25s,
      border-color 0.25s;
  }

  .hero__cue {
    left: var(--gutter);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
