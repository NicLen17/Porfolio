---
import Ambient from './Ambient.astro';
import { certifications, type Content, type Lang } from '../i18n/content';

interface Props {
  t: Content;
  lang: Lang;
}

const { t, lang } = Astro.props;
const c = t.creds;
const firstCerts = certifications.slice(0, 6);
const moreCerts = certifications.slice(6);
const ids = ['quotes', 'education', 'certs'];
---

<section class="section section--paper creds cut" id="credentials" data-live aria-labelledby="creds-title">
  <Ambient kind="binary" />
  <div class="wrap">
    <header class="creds__head" data-rise>
      <p class="eyebrow">{c.tabsLabel}</p>
      <h2 class="section__title display" id="creds-title">{c.title}</h2>
      <div class="creds__tabs" role="tablist" aria-label={c.tabsLabel} data-tabs>
        {
          c.tabs.map((label, i) => (
            <button class="btn creds__tab" type="button" role="tab" id={`tab-${ids[i]}`} aria-controls={`panel-${ids[i]}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              {label}
            </button>
          ))
        }
      </div>
    </header>

    <div class="creds__panel" role="tabpanel" id="panel-quotes" aria-labelledby="tab-quotes" tabindex="0">
      <ul class="creds__quotes">
        {
          c.quotes.map((quote) => (
            <li>
              <figure>
                <blockquote>{quote.text}</blockquote>
                <figcaption>
                  <b>{quote.name}</b>
                  <span>{quote.role}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="creds__panel" data-later role="tabpanel" id="panel-education" aria-labelledby="tab-education" tabindex="0">
      <ul class="creds__cards">
        {
          c.education.map((item) => (
            <li>
              <span class="creds__when">{item.when}</span>
              <b>{item.title}</b>
              <span>{item.school}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="creds__panel" data-later role="tabpanel" id="panel-certs" aria-labelledby="tab-certs" tabindex="0">
      <ul class="creds__cards">
        {
          firstCerts.map((cert) => (
            <li>
              <span class="creds__when">{cert.year}</span>
              <b>{cert[lang]}</b>
              <span>{cert.issuer}</span>
            </li>
          ))
        }
      </ul>
      <details class="creds__more" data-fold>
        <summary>{c.more}</summary>
        <div class="creds__fold" data-fold-body>
        <ul class="creds__cards">
          {
            moreCerts.map((cert, i) => (
              <li style={`--i:${i}`}>
                <span class="creds__when">{cert.year}</span>
                <b>{cert[lang]}</b>
                <span>{cert.issuer}</span>
              </li>
            ))
          }
        </ul>
        </div>
      </details>
    </div>
  </div>
</section>

<style is:global>
  .creds {
    border-top: 1px solid var(--line-soft);
  }

  /* Same state the tabs script sets, applied before first layout so nothing reflows. */
  html.js .creds__panel[data-later] {
    display: none;
  }

  .creds__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .creds__tabs {
    display: none;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Without JS every panel is simply shown, one after the other. */
  .js .creds__tabs {
    display: flex;
  }

  /* Tabs are the same button as everywhere else; the chosen one stays filled. */
  .creds__tab {
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    font-size: var(--step--1);
  }

  .creds__tab[aria-selected='true'] {
    border-color: var(--ink);
    color: var(--black);
  }

  .creds__tab[aria-selected='true']::before {
    transform: none;
    transform-origin: left;
  }

  .creds__panel + .creds__panel {
    margin-top: 3rem;
  }

  .js .creds__panel + .creds__panel {
    margin-top: 0;
  }

  .js .creds__panel[hidden] {
    display: none;
  }

  .js .creds__panel {
    animation: creds-in 0.5s var(--ease-out);
  }

  @keyframes creds-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .creds__quotes,
  .creds__cards {
    display: grid;
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .creds__quotes,
    .creds__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .creds__quotes li,
  .creds__cards li {
    background: var(--black);
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }

  .creds__quotes figure {
    display: grid;
    gap: 1.5rem;
    height: 100%;
    align-content: space-between;
  }

  .creds__quotes blockquote {
    font-size: var(--step-1);
    line-height: 1.35;
    text-wrap: pretty;
  }

  .creds__quotes blockquote::before {
    content: '“';
    display: block;
    height: 0.55em;
    font-family: var(--font-display);
    font-size: 3em;
    line-height: 1;
    color: var(--accent);
  }

  .creds__quotes figcaption {
    display: grid;
    gap: 0.15rem;
    font-size: var(--step--1);
    color: var(--ink-dim);
  }

  .creds__quotes figcaption b {
    font-weight: 600;
    color: var(--ink);
  }

  .creds__cards li {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    font-size: var(--step--1);
    color: var(--ink-dim);
  }

  .creds__cards b {
    font-size: var(--step-0);
    font-weight: 550;
    line-height: 1.3;
    color: var(--ink);
    text-wrap: balance;
  }

  .creds__when {
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--accent);
    white-space: nowrap;
  }

  .creds__more {
    margin-top: 1rem;
  }

  .creds__more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.5rem 0;
    font-size: var(--step--1);
    color: var(--ink-dim);
    cursor: pointer;
    list-style: none;
  }

  .creds__more summary::-webkit-details-marker {
    display: none;
  }

  .creds__more summary::before {
    content: '+';
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    transition: transform 0.45s var(--ease-out);
  }

  .creds__more.is-open summary::before,
  html:not(.js) .creds__more[open] summary::before {
    transform: rotate(135deg);
  }

  /* Height is animated by page.ts; the cards then deal in one by one. */
  .creds__fold {
    overflow: hidden;
  }

  .js .creds__fold li {
    opacity: 0;
    transform: translateY(0.9rem);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .js .creds__more.is-open .creds__fold li {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 45ms + 80ms);
  }

  .creds__more summary:hover {
    color: var(--ink);
  }

  .creds__more .creds__cards {
    margin-top: 0.5rem;
  }
</style>
